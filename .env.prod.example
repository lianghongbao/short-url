# 生产环境配置模板
# 复制此文件为 .env 并填写实际值

# 阿里云容器镜像仓库
GOLANG_IMAGE=your-registry:golang-1.25-alpine
ALPINE_IMAGE=your-registry:alpine-3.21
MONGO_IMAGE=your-registry:mongo-7.0
# 仅在 --profile standalone 启动独立 Redis 时使用
REDIS_IMAGE=your-registry:redis-7.0

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8080
APP_MODE=release

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=
MONGODB_URI=mongodb://admin:<PASSWORD>@mongo:27017/?authSource=admin
MONGODB_DATABASE=shorturl_db
MONGODB_COLLECTION=short_urls

# Redis —— 容器之间用容器名 + 外部网络解析，DB 号用于与同实例的其他应用隔离
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=3

# 构建 tag
TAG=latest
