# 本地开发 + 生产部署配置模板
# 复制此文件为 .env 并填写实际值
#
# 本地开发: 直接跑 docker compose up -d --build
# 生产部署: 填 ACR_REGISTRY_HOST / ACR_NAMESPACE / IMAGE_NAME / REGISTRY_USERNAME / REGISTRY_PASSWORD
#          (这几个值跟 GitHub repo Settings → Secrets and variables → Actions 里的 Vars + Secrets 一致)

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8080
APP_MODE=release

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123
MONGODB_URI=mongodb://admin:admin123@mongo:27017/?authSource=admin
MONGODB_DATABASE=shorturl_db
MONGODB_COLLECTION=short_urls

# Redis —— 容器之间用容器名 + 外部网络解析，DB 号用于与同实例的其他应用隔离
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=3

# ============================================================
# 容器镜像仓库配置
# 这几个值跟 GitHub repo Vars + Secrets 一致
# ============================================================
# 镜像仓库公网端点(不带 -vpc)
ACR_REGISTRY_HOST=your-acr-registry-host
# 镜像仓库 namespace/repo
ACR_NAMESPACE=your-namespace/your-repo
# 业务镜像名(不含仓库前缀)。compose 的 image: 由 ACR_REGISTRY_HOST/ACR_NAMESPACE/IMAGE_NAME 拼出
IMAGE_NAME=short-url-server

# 镜像仓库登录凭证(用于服务器上 pull 镜像)
# 注意: build 用的 ACR_USERNAME/ACR_PASSWORD 配在 GitHub Secrets,不在 .env
REGISTRY_USERNAME=your-acr-ram-user
REGISTRY_PASSWORD=your-acr-ram-password

# 构建 tag
TAG=latest
